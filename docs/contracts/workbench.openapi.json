    "/conversations/{conversationId}/events": {
      "get": {
        "operationId": "subscribeEvents",
        "summary": "订阅可恢复SSE事件",
        "tags": [
          "workbench"
        ],
        "responses": {
          "200": {
            "description": "SSE，事件正文协议参见02-接口与组件协议.md；断线不取消任务。",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "id: 128\nevent: task.updated\ndata: {\"schemaVersion\":\"1.0\",\"eventId\":\"128\",\"payload\":{\"status\":\"WAITING_INPUT\"}}\n\n"
              }
            }
          },
          "default": {
            "description": "结构化错误。非本人资源返回404；异步业务失败另查任务/事件。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "afterEventId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        ],
        "description": "两种游标同时给出时必须相同；事件按会话序号去重，15秒心跳；过期游标返回409 EVENTS_EXPIRED，重新获取快照。"
      }
    },
